{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["chrome"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  // Build configs are deliberately excluded: they run in Node, and pulling in
  // @types/node here would put `process` and friends in scope for the extension
  // code too. `npm run build` in CI is what validates them.
  "include": ["src", "test"]
}
