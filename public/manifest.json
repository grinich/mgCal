{
  "manifest_version": 3,
  "name": "mgCal",
  "description": "Instant local-first Google Calendar",
  "version": "0.2.0",
  "key": "",
  "background": { "service_worker": "sw.js", "type": "module" },
  "chrome_url_overrides": { "newtab": "index.html" },
  "action": { "default_title": "Open Calendar" },
  "commands": {
    "open-calendar": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Open calendar"
    }
  },
  "permissions": ["identity", "storage", "alarms", "notifications"],
  "host_permissions": ["https://www.googleapis.com/*", "https://api.github.com/*"],
  "oauth2": {
    "client_id": "959761213326-6phclbcb6jeppujj4spo5ofqgoff6378.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar"]
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
